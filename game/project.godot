; Engine configuration file.
config_version=5

[application]

config/name="Flugkern M2"
config/description="Meilenstein 3: Bodenbetrieb – Tanken, Munition, Reparatur, KI-Flugbetrieb; Luftkampf 1 gegen 3"
config/version="3.0"
run/main_scene="res://world/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[editor]

export/convert_text_resources_to_binary=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="aircraft"
3d_physics/layer_3="ground_vehicle"
3d_physics/layer_4="character"
3d_physics/layer_5="wreck"
3d_physics/layer_6="sensor"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
